# Copy to .env for local runs. On Railway, paste these into the service's Variables tab.
# Never commit a real .env. It's in .gitignore.

# ---------- Character ----------
AGENT_NAME=YourAgent
CHARACTER_PATH=./prompts/character.md
ROAST_PATH=./prompts/roast-mode.md
CONTEXT_DIR=./context
PROFILES_DIR=./profiles
MAX_CONTEXT_FILES=2

# ---------- Models ----------
# Format: provider:model. Providers: anthropic, openrouter, openai, custom.
# Copy exact OpenRouter slugs from https://openrouter.ai/models (they change often).
#
# Start cheap everywhere, run voice_test.py, upgrade only the tier that fails.
MODEL_DEFAULT=openrouter:<provider>/<cheap-model>
MODEL_VOICE=openrouter:<provider>/<cheap-model>
MODEL_KNOWLEDGE=openrouter:<provider>/<stronger-model>
MODEL_PREPROCESS=openrouter:<provider>/<cheapest-model>
MODEL_REFLECT=
# Optional safety net if a cheap endpoint flakes or can't read images.
# Needs its provider's key set, e.g. anthropic:claude-haiku-4-5-20251001 + ANTHROPIC_API_KEY
MODEL_FALLBACK=
# Force one model for everything (testing only):
MODEL_OVERRIDE=

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any OpenAI-compatible server (Ollama, Together, Groq, DeepSeek, Fireworks, vLLM):
CUSTOM_BASE_URL=http://localhost:11434/v1
CUSTOM_API_KEY=

# Output limits. VOICE_MAX_TOKENS is a hard leash on chatty models.
VOICE_MAX_TOKENS=300
MAX_TOKENS=600
VOICE_TEMPERATURE=0.9
MAX_POST_CHARS=280

# ---------- Slack (command center + test bench) ----------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DRAFT_CHANNEL_ID=
# Comma-separated Slack member IDs (start with U) allowed to approve drafts, post,
# reply, reflect, announce tx, and "go live". Read-only wallet checks are open.
ADMIN_SLACK_IDS=
# Append the model name to Slack replies while you're comparing models:
SHOW_MODEL_IN_SLACK=true

# ---------- Twitter / X ----------
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=
# Leave false until the voice passes in Slack:
TWITTER_AUTO_REPLY=false
TWITTER_POLL_INTERVAL=90
# Stops two agents from replying to each other forever:
MAX_REPLIES_PER_AUTHOR_PER_HOUR=5
# The project's main account. Daily drafts riff on what it posts:
SOURCE_TWITTER_HANDLE=
DAILY_DRAFTS_ENABLED=true
DRAFT_TIMES_UTC=12:00,19:00
DRAFTS_PER_RUN=4

# ---------- Storage + admin ----------
# Railway: add a Volume mounted at /data or the database resets on every deploy.
# Running main.py locally: use DB_PATH=./agent.db
DB_PATH=/data/agent.db
# Long random string. Required for /draft, /roast, /reflect and /admin/* endpoints.
ADMIN_API_KEY=

# ---------- Optional ----------
# NFT trait lookups ("#1234"). Set COLLECTION_SIZE and ingest a metadata file.
COLLECTION_SIZE=0
METADATA_PATH=collection-metadata.json
# Live data API (see data_api_client.py):
DATA_API_BASE=
# Read-only public wallet address for the character:
AGENT_WALLET_ADDRESS=
ETH_RPC_URL=https://eth.llamarpc.com
BASE_RPC_URL=https://mainnet.base.org
